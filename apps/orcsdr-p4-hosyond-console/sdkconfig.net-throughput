# TCP windows sized for a raw IQ stream (esp-rtl-tcp, 2.4 MS/s = 38 Mbit/s). lwip's default 5760 bytes (four segments) limits a single
# stream to a few tens of Mbit/s on a LAN and made a wired 100 Mbit link drop blocks. lwip buffers go to PSRAM where possible
# (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP). Measure before making this a default for every board.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_SOCKETS=16
