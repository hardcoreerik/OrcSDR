CONFIG_ORCSDR_BOARD_LILYGO_T_DISPLAY_P4_AMOLED=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=37
CONFIG_ESP_CONSOLE_UART_RX_GPIO=38
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=-1
# Long file names for the microSD (the Shortwave library folder and file, renames): without these only 8.3 names can be
# created. Same values as the Tab5 build.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
