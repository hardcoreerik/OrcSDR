# Probe-only config. Does not modify apps/orcsdr-tab5/sdkconfig.defaults.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_DMR_PROBE_SECONDS=30
CONFIG_DMR_PROBE_PSRAM=y
# CONFIG_DMR_PROBE_FORCE_OVERLOAD is not set
